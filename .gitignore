# =============================================================================
# mvp-template — root .gitignore
# Covers: init-app (Flutter), init-api (Python), skills, artifacts
# =============================================================================

# --- OS / editor noise ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
*.iml
*.ipr
*.iws
.vscode/

# --- Skills pipeline output (per-project, generated by agent) ---
artifacts/

# --- Secrets (never commit) ---
.env
.env.*
!.env.example
!**/.env.example

# =============================================================================
# init-api — Python / FastAPI
# =============================================================================
init-api/.venv/
init-api/venv/
init-api/__pycache__/
init-api/**/__pycache__/
init-api/*.py[cod]
init-api/**/*.py[cod]
init-api/*.egg-info/
init-api/.pytest_cache/
init-api/.mypy_cache/
init-api/.ruff_cache/
init-api/htmlcov/
init-api/.coverage
init-api/coverage.xml
init-api/test.db
init-api/*.db

# =============================================================================
# init-app — Flutter mobile
# =============================================================================
init-app/.dart_tool/
init-app/.flutter-plugins
init-app/.flutter-plugins-dependencies
init-app/.packages
init-app/.pub-cache/
init-app/.pub/
init-app/build/
init-app/**/doc/api/
init-app/**/ios/Flutter/.last_build_id

# Flutter / IDE
init-app/.idea/
init-app/**/*.iml
init-app/mobile_template.iml

# Client env source (keep .env.example; .env.* already ignored at root)
init-app/assets/env/.env

# Android
init-app/android/.gradle/
init-app/android/.kotlin/
init-app/android/local.properties
init-app/android/captures/
init-app/android/.cxx/
init-app/android/app/debug/
init-app/android/app/profile/

# iOS / CocoaPods (platform .gitignore files also apply)
init-app/ios/Pods/
init-app/ios/.symlinks/
init-app/ios/**/DerivedData/
init-app/ios/**/xcuserdata/
init-app/ios/Flutter/ephemeral/
init-app/ios/Flutter/Generated.xcconfig
init-app/ios/Flutter/flutter_export_environment.sh
init-app/ios/Runner/GeneratedPluginRegistrant.*

# Local helper scripts (not part of template)
init-app/check_16kb_alignment.sh
init-app/detailed_alignment_analysis.sh
init-app/quick_16kb_check.sh

# =============================================================================
# skills — commit skill definitions; ignore local noise only
# =============================================================================
skills/.DS_Store
skills/**/.DS_Store
