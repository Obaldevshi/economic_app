# Database
DATABASE_URL=postgresql://postgres:password@db:5432/not_spent

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application
APP_NAME=Not Spent API
APP_VERSION=1.0.0
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://10.0.2.2:8000

# Password recovery: backend only. Never put mail credentials into Flutter env.
# Enable only after the mailbox, TLS connection and delivery have been checked.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_PROVIDER=smtp
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=noreply@sberiga.ru
SMTP_SENDER_EMAIL=noreply@sberiga.ru
SMTP_PASSWORD=
# Optional legacy provider: set PASSWORD_RESET_PROVIDER=gmail to use Gmail API.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=mnyvault@gmail.com
PASSWORD_RESET_DAILY_LIMIT=100
